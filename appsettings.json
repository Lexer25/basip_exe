{
  "Logging": {
    "LogLevel": {
      //Уровень вывода в консоль. Файловый журнал управляется секцией "Log".
      "Default": "Trace"
    }
  },
  "Log": {
    "LogFolerPath": "C:\\ProgramData\\Basip\\",

	//"LogLevel": "Trace",       // 0 — пропускать всё, включая самые детальные сообщения (может содержать чувствительные данные)
	//"LogLevel": "Debug",       // 1 — пропускать Debug и выше (отладочная информация для разработки)
	"LogLevel": "Information", // 2 — пропускать Information и выше (нормальный ход работы приложения)
	//"LogLevel": "Warning",     // 3 — пропускать Warning и выше (что-то пошло не так, но работа продолжается)
	//"LogLevel": "Error",       // 4 — пропускать Error и выше (ошибка выполнения операции)
	//"LogLevel": "Critical",    // 5 — пропускать только Critical (критический сбой, приложение не может продолжать)
	//"LogLevel": "None",        // 6 — не пропускать ничего (специальное значение для полного отключения вывода)
 
    //Уровень журнала процессов (категория Basip.Processing): подробности обработки событий
    //и дампы LogItem. Ведётся отдельно от ошибок, в файле basipkeysservices_ГГГГ_ММ_ДД.log.
    //По умолчанию равен Log:LogLevel.
    "ProcessLogLevel": "Trace",
    "retainedFileCountLimit": 7
  },
  "Service": {
    //Строка подключения к базе данных Firebird.
    //ВНИМАНИЕ: значение не хранится в репозитории. Заполните его при установке,
    //иначе служба не запустится и завершится с ошибкой в журнале.
    //Пример: "User=SYSDBA;Password=ваш_пароль;Database=C:\\Path\\To\\shieldpro_rest.gdb;DataSource=127.0.0.1;Port=3050;"
    "db_config": "",

    //0->'HEX 8 byte 00124CD8' 
    //1->'00110A byte 262F8F001A' 
    //2->'DEC 10 digit 0001493650'
    "format_card_uid": 2,
    //запустить сейчас игнорируя время первой итерации
    "run_now": true,
    //время первой итерации
    "timestart": "9:10:0",
    //интервал между периодами опроса 
    "timeout": "0:0:10",
    //время ожидания http запроса
    "time_wait_http": 10,
    //очищать журнал событий
    "clear_log": true
  }
}
