{
  "Logging": {
    "LogLevel": {
      //Уровень вывода в консоль. Файловый журнал управляется секцией "Log".
      "Default": "Trace"
    }
  },
  "Log": {
    "LogFolerPath": "C:\\ProgramData\\Basip\\",
    //"LogLevel": "Information",
    "LogLevel": "Trace",
    "retainedFileCountLimit": 7
  },
  "Service": {
    //Строка подключения к базе данных Firebird.
    //ВНИМАНИЕ: значение не хранится в репозитории. Заполните его при установке,
    //иначе служба не запустится и завершится с ошибкой в журнале.
    //Пример: "User=SYSDBA;Password=ваш_пароль;Database=C:\\Path\\To\\shieldpro_rest.gdb;DataSource=127.0.0.1;Port=3050;"
    "db_config": "",

    //0->'HEX 8 byte 00124CD8' 
    //1->'00110A byte 262F8F001A' 
    //2->'DEC 10 digit 0001493650'
    "format_card_uid": 2,
    //запустить сейчас игнорируя время первой итерации
    "run_now": true,
    //время первой итерации
    "timestart": "9:10:0",
    //интервал между периодами опроса 
    "timeout": "0:0:10",
    //время ожидания http запроса
    "time_wait_http": 10,
    //очищать журнал событий
    "clear_log": true
  }
}
