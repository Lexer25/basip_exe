<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Basip-cb8c693b-e5ee-4fcf-9faa-8403bced6feb</UserSecretsId>
    <Version>2.0.5.1</Version>
    <AssemblyVersion>2.0.5.1</AssemblyVersion>
    <FileVersion>2.0.5.1</FileVersion>
    <InformationalVersion>2.0.5.1</InformationalVersion>
    <ProductVersion>2.0.5.1</ProductVersion>
    <!-- Без этого SDK дописывает к версии хэш коммита (2.0.5.1+<sha>),
         а версия должна отображаться ровно как 2.0.5.1. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>basipkeysservices</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.2" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.2" />
	<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.2" />
	<PackageReference Include="RestSharp" Version="112.1.0" />
	<PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
  </ItemGroup>

  <!-- appsettings.Development.json содержит отладочную строку подключения.
       В поставку он попадать не должен: иначе на стенде он переопределит боевой
       appsettings.json, если служба запустится в окружении Development. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.json.example" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
