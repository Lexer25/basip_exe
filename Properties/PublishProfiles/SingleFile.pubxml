<?xml version="1.0" encoding="utf-8"?>
<!--
  Профиль публикации: единый exe (~5 МБ), как в версиях до 2.0.3.4.
  Использование: dotnet publish Basip.csproj -p:PublishProfile=SingleFile
  Тот же результат даёт build.bat.

  Требование к целевой машине: установленный .NET Runtime 8.0 (Microsoft.NETCore.App 8.x).
  Самодостаточный вариант (без требования к рантайму) весит около 34 МБ со сжатием или 67 МБ без.
  Для него в командной строке дополнительно указываются self-contained=true,
  IncludeAllContentForSelfExtract=true и EnableCompressionInSingleFile=true.

  ВНИМАНИЕ: в XML-комментарии нельзя использовать два дефиса подряд (MSB4024).
  Раньше здесь была строка с параметром self-contained, записанным с двумя дефисами,
  из-за чего профиль не загружался и публикация падала.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
